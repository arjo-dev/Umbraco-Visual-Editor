# Credentials for the Umbraco Developer MCP server (see docs/mcp.md).
# Copy to .env.mcp (gitignored) and fill in from the Test Site's API user.
UMBRACO_CLIENT_ID=umbraco-back-office-mcp
UMBRACO_CLIENT_SECRET=

# Optional overrides of the defaults in .mcp.json
# UMBRACO_BASE_URL=https://localhost:44394
# UMBRACO_READONLY=true
