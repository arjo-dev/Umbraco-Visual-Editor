{
	"name": "arjo-visual-editor",
	"private": true,
	"version": "0.0.0",
	"type": "module",
	"engines": {
		"node": ">=24"
	},
	"scripts": {
		"watch": "tsc && vite build --watch",
		"build": "tsc && vite build",
		"check": "tsc",
		"lint": "eslint .",
		"lint:fix": "eslint . --fix",
		"format": "prettier . --write",
		"format:check": "prettier . --check",
		"generate-client": "node scripts/generate-openapi.js https://localhost:44394/umbraco/openapi/arjovisualeditor.json",
		"test": "web-test-runner",
		"test:watch": "web-test-runner --watch"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@hey-api/openapi-ts": "^0.99.0",
		"@open-wc/testing": "^5.0.0",
		"@tiptap/core": "3.31.3",
		"@tiptap/extension-bold": "3.31.3",
		"@tiptap/extension-document": "3.31.3",
		"@tiptap/extension-heading": "3.31.3",
		"@tiptap/extension-paragraph": "3.31.3",
		"@tiptap/extension-text": "3.31.3",
		"@tiptap/extensions": "3.31.3",
		"@types/mocha": "^10.0.10",
		"@umbraco-cms/backoffice": "^18.2.0",
		"@web/dev-server-esbuild": "^2.0.0",
		"@web/test-runner": "^1.0.0",
		"@web/test-runner-playwright": "^1.0.0",
		"chalk": "^5.6.2",
		"cross-env": "^10.1.0",
		"eslint": "^10.11.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-lit": "^2.3.1",
		"globals": "^17.12.0",
		"lit": "3.3.3",
		"node-fetch": "^3.3.2",
		"prettier": "^3.9.9",
		"typescript": "^5.9.3",
		"typescript-eslint": "^8.70.1",
		"vite": "^7.3.1"
	},
	"dependencies": {
		"idiomorph": "0.8.0"
	}
}
