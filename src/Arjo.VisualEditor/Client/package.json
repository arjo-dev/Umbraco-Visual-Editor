{
	"name": "arjo-visual-editor",
	"private": true,
	"version": "0.0.0",
	"type": "module",
	"engines": {
		"node": ">=24"
	},
	"scripts": {
		"watch": "tsc && vite build --watch",
		"build": "tsc && vite build",
		"check": "tsc",
		"lint": "eslint .",
		"lint:fix": "eslint . --fix",
		"format": "prettier . --write",
		"format:check": "prettier . --check",
		"generate-client": "node scripts/generate-openapi.js https://localhost:44394/umbraco/openapi/arjovisualeditor.json"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@hey-api/openapi-ts": "^0.99.0",
		"@umbraco-cms/backoffice": "^18.2.0",
		"chalk": "^5.6.2",
		"cross-env": "^10.1.0",
		"eslint": "^10.11.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-lit": "^2.3.1",
		"globals": "^17.12.0",
		"node-fetch": "^3.3.2",
		"prettier": "^3.9.9",
		"typescript": "^5.9.3",
		"typescript-eslint": "^8.70.1",
		"vite": "^7.3.1"
	}
}
