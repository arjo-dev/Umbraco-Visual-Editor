@inherits UmbracoViewPage<CompatPage>
@*
    The compatibility page (#38): each section renders content the way some sites do, rather than as Clean does.
*@
@{
    Layout = null;
}
<!doctype html>
<html lang="en">
<head>
    <meta charset="utf-8">
    <title>@Model.Title</title>
    <style>
        body { margin: 0; font: 16px/1.5 system-ui, sans-serif; color: #1b264f; }
        main { max-width: 56rem; margin: 0 auto; padding: 2rem 1rem; display: grid; grid-template-columns: 1fr 16rem; gap: 2rem; }
        h1 { grid-column: 1 / -1; font-size: 2.5rem; margin: 0; }
        .cards, .more-cards { display: grid; gap: 1rem; }
        .card { border: 1px solid #d8d7d9; border-radius: 6px; padding: 1rem; }
        .card h3 { margin: 0 0 .25rem; }
        aside, footer { background: #f3f3f5; border-radius: 6px; padding: 1rem; }
        footer { grid-column: 1 / -1; }
    </style>
</head>
<body>
    <main>
        <h1>@Model.Title</h1>

        <div>
            <section class="body">@Model.Body</section>

            <h2>Cards</h2>
            @* A hand-rolled loop with a view of its own: the partial gets the block, so it's marked automatically. *@
            <div class="cards">
                @foreach (BlockListItem block in Model.Cards ?? Enumerable.Empty<BlockListItem>())
                {
                    @await Html.PartialAsync("Cards/Card", block)
                }
            </div>

            <h2>More cards</h2>
            @* The partial only gets the element (block.Content): still marked automatically, by the element. *@
            <div class="more-cards">
                @foreach (BlockListItem block in Model.MoreCards ?? Enumerable.Empty<BlockListItem>())
                {
                    @await Html.PartialAsync("Cards/CardElement", block.Content)
                }
            </div>

            <h2>Inline cards</h2>
            @* Markup written in the loop itself: no view per block to recognise it by, so the opt-in helper marks it. *@
            <div class="inline-cards">
                @foreach (BlockListItem block in Model.InlineCards ?? Enumerable.Empty<BlockListItem>())
                {
                    var card = (CompatCard)block.Content;
                    using (Html.VisualEditorBlock(block))
                    {
                        <article class="card">
                            <h3>@card.Heading</h3>
                            <p>@card.Text</p>
                        </article>
                    }
                }
            </div>
        </div>

        @* A view component, unless the True/False says to hide it. *@
        @if (!Model.HideSidebar)
        {
            <aside>@await Component.InvokeAsync("CompatSidebar", new { page = Model })</aside>
        }

        @* A cached partial: in edit mode it must render fresh, with markers, and never fill the cache. *@
        @await Html.CachedPartialAsync("CachedFooter", Model, TimeSpan.FromMinutes(10))
    </main>
</body>
</html>