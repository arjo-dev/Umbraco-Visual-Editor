<Project Sdk="Microsoft.NET.Sdk.Web">
  <!--
    A second site for compatibility checks (#38): plain Umbraco (no Clean, no uSync), compiled models written by hand
    (ModelsBuilder "Nothing", Development runtime mode) and templates using other conventions: hand-rolled block loops,
    a view component, CachedPartialAsync and output caching. Its content is created in code on first boot
    (Composers/CompatContentComposer.cs). See docs/compatibility.md.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>Umbraco_Visual_Editor.Compat_Site</RootNamespace>
    <CompressionEnabled>false</CompressionEnabled>
    <UserSecretsId>952dc099-6826-40d9-abc6-c9c7c3766f9c</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Umbraco.Cms" />
  </ItemGroup>

  <PropertyGroup>
    <UmbracoUseAppLocalIcu Condition="'$(UmbracoUseAppLocalIcu)' == '' and ($(RuntimeIdentifier.StartsWith('linux')) or $(RuntimeIdentifier.StartsWith('win')) or ('$(RuntimeIdentifier)' == '' and !$([MSBuild]::IsOSPlatform('osx'))))">true</UmbracoUseAppLocalIcu>
    <UmbracoUseAppLocalIcu Condition="'$(UmbracoUseAppLocalIcu)' == ''">false</UmbracoUseAppLocalIcu>
    <UmbracoAppLocalIcuVersion Condition="'$(UmbracoAppLocalIcuVersion)' == ''">72.1.0.3</UmbracoAppLocalIcuVersion>
  </PropertyGroup>

  <ItemGroup Condition="'$(UmbracoUseAppLocalIcu)' == 'true'">
    <PackageReference Include="Microsoft.ICU.ICU4C.Runtime" />
    <RuntimeHostConfigurationOption Include="System.Globalization.AppLocalIcu" Value="$(UmbracoAppLocalIcuVersion)" />
  </ItemGroup>

  <PropertyGroup>
    <!-- Razor files are needed for the backoffice to work correctly -->
    <CopyRazorGenerateFilesToPublishDirectory>true</CopyRazorGenerateFilesToPublishDirectory>
  </PropertyGroup>

  <!--
    The package under test: the project, or (with -p:VisualEditorPackageVersion=x, and the folder holding it in
    RestoreAdditionalProjectSources) the packed NuGet package, installed as a site would (#39). The release workflow
    tests the packages it's about to publish this way.
  -->
  <ItemGroup Condition="'$(VisualEditorPackageVersion)' == ''">
    <ProjectReference Include="..\src\UmbracoVisualEditor\UmbracoVisualEditor.csproj" />
  </ItemGroup>
  <ItemGroup Condition="'$(VisualEditorPackageVersion)' != ''">
    <PackageReference Include="UmbracoVisualEditor" VersionOverride="$(VisualEditorPackageVersion)" />
  </ItemGroup>

  <!-- As the NuGet package does it (buildTransitive): the VisualEditor settings in the appsettings schema. -->
  <Import Project="..\src\UmbracoVisualEditor\buildTransitive\UmbracoVisualEditor.targets" Condition="'$(VisualEditorPackageVersion)' == ''" />

</Project>
