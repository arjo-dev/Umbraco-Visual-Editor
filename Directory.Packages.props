<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <CentralPackageFloatingVersionsEnabled>true</CentralPackageFloatingVersionsEnabled>
    <!--
      Single source of truth for the Umbraco version used by the extension and the sites. 18 by default; build for
      Umbraco 17 with -p:UmbracoVersion=17.x (or an UmbracoVersion environment variable), see docs/compatibility.md.
    -->
    <UmbracoVersion Condition="'$(UmbracoVersion)' == ''">18.2.0</UmbracoVersion>
    <!--
      The extension's Umbraco dependencies are a range, from the version it's built against to the next major (#39): a
      build is for one major (see docs/compatibility.md), so the package must not install on another.
      [18.2.0, 19.0.0) by default; restore still uses the lowest, the version built against.
    -->
    <UmbracoMajor>$(UmbracoVersion.Substring(0, $(UmbracoVersion.IndexOf('.'))))</UmbracoMajor>
    <UmbracoDependencyRange>[$(UmbracoVersion), $([MSBuild]::Add($(UmbracoMajor), 1)).0.0)</UmbracoDependencyRange>
    <!--
      Default must match UmbracoAppLocalIcuVersion in the Test Site csproj. Defined here too because this file
      is imported before the main project's own PropertyGroup runs, so under CPM the PackageVersion below needs
      its own fallback to stay in sync with the RuntimeHostConfigurationOption value set from the same property.
    -->
    <UmbracoAppLocalIcuVersion Condition="'$(UmbracoAppLocalIcuVersion)' == ''">72.1.0.3</UmbracoAppLocalIcuVersion>
  </PropertyGroup>

  <!-- Extension (src/Arjo.VisualEditor) -->
  <ItemGroup>
    <PackageVersion Include="Umbraco.Cms.Api.Common" Version="$(UmbracoDependencyRange)" />
    <PackageVersion Include="Umbraco.Cms.Api.Management" Version="$(UmbracoDependencyRange)" />
    <PackageVersion Include="Umbraco.Cms.Web.Common" Version="$(UmbracoDependencyRange)" />
    <PackageVersion Include="Umbraco.Cms.Web.Website" Version="$(UmbracoDependencyRange)" />
    <!-- See the comment in Arjo.VisualEditor.csproj for why this is referenced directly. -->
    <PackageVersion Include="Microsoft.AspNetCore.OpenApi" Version="10.0.11" />
  </ItemGroup>

  <!-- Tests (tests/) -->
  <ItemGroup>
    <PackageVersion Include="xunit.v3" Version="4.0.1" />
  </ItemGroup>

  <!-- Test Site -->
  <ItemGroup>
    <PackageVersion Include="Umbraco.Cms" Version="$(UmbracoVersion)" />
    <PackageVersion Include="Umbraco.Cms.DevelopmentMode.Backoffice" Version="$(UmbracoVersion)" />
    <PackageVersion Include="Clean" Version="8.0.1" />
    <PackageVersion Include="uSync" Version="18.1.4" />
    <PackageVersion Include="Microsoft.ICU.ICU4C.Runtime" Version="$(UmbracoAppLocalIcuVersion)" />
  </ItemGroup>
</Project>
